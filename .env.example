APP_NAME=Ruveon AI
APP_ENV=development
API_V1_PREFIX=/api/v1

# Backend: use a managed PostgreSQL URL in production.
DATABASE_URL=sqlite:///./ruveon.db
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_IDLE_TIMEOUT_MINUTES=30
CORS_ORIGINS=https://your-website.vercel.app

# Gemini (keep this key on the backend only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API (optional until WhatsApp onboarding is complete).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_API_VERSION=v23.0

# Frontend: set this in Vercel to the deployed API URL plus /api/v1.
VITE_API_BASE_URL=https://your-api.onrender.com/api/v1
